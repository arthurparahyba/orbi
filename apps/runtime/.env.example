# Claude Haiku 5.5 via Anthropic API (used by every agent and by the Claude Code fixer)
ANTHROPIC_API_KEY=
# ORBI_MODEL=anthropic/claude-haiku-5-5
# ORBI_CODE_MODEL=claude-haiku-5-5
# ORBI_CODE_FIX_BUDGET_USD=0.5

# Where your repositories are cloned (commands run inside this folder; ~ works and it is created if missing)
ORBI_WORKSPACE=~/projetos
# CLIs the agent may run (no shell; binary + args)
# ORBI_ALLOWED_BINARIES=git,gh,aws,python3

# Credentials handed to CLIs explicitly (never the whole environment)
GH_TOKEN=
AWS_PROFILE=
AWS_REGION=sa-east-1

# Chrome DevTools MCP bridge
# Attach to your own Chrome (keeps your SSO sessions): start Chrome with
#   --remote-debugging-port=9222 --user-data-dir=~/.orbi-chrome
# CHROME_BROWSER_URL=http://127.0.0.1:9222
# CHROME_MCP_PORT=8931
# CHROME_MCP_TOKEN=   # generated per run when empty
# CHROME_HEADLESS=false

# Local data (brain.db, flue.db, inbox, autonomy)
# ORBI_DATA_DIR=./data
# Require a bearer token on the local HTTP API
# ORBI_API_TOKEN=

# ── Ensinar pelo navegador ───────────────────────────────────────────────
# Chrome que o Orbi abre (perfil próprio em data/chrome-profile; logins persistem)
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_DEBUG_PORT=9333
# CHROME_BROWSER_URL=http://127.0.0.1:9222   # usar um Chrome seu, aberto com --remote-debugging-port

# Cofre de credenciais: auto (Keychain do macOS; arquivo criptografado se não houver) | keychain | file
# ORBI_VAULT=auto
# ORBI_VAULT_KEY=...                         # só para o modo file: chave em vez de data/vault.key

# Transcrição da narração: local (Whisper nesta máquina) | http | off
# ORBI_STT=local
# ORBI_STT_LOCAL_MODEL=onnx-community/whisper-small   # ~250 MB, baixado na 1ª vez para data/models
# ORBI_STT_URL=https://api.openai.com/v1/audio/transcriptions   # qualquer endpoint compatível
# ORBI_STT_API_KEY=...
# ORBI_STT_MODEL=whisper-1
# ORBI_STT_LANGUAGE=pt
