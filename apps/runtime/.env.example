# ── Modelo de linguagem ───────────────────────────────────────────────────────
# Padrão: Claude Haiku 5.5 pela API da Anthropic (agentes e corretor Claude Code)
ANTHROPIC_API_KEY=

# Outro provedor (docs/llm-adaptadores.md). Exemplo: gateway compatível com OpenAI
# ORBI_LLM=openai-compatible
# ORBI_LLM_BASE_URL=https://gateway.empresa/v1
# ORBI_LLM_API_KEY=
# ORBI_LLM_MODEL=nome-do-modelo
# ORBI_LLM_HEADERS={"x-tenant":"meu-time"}
# Ou o LLM da sua empresa, por um plugin (npm run plugin:new -- <nome>; docs/plugins.md):
# ORBI_LLM=gateway-empresa
# Agente de código instalado nesta máquina, para o Orbi corrigir código numa cópia descartável
# do repositório (roda pelo terminal; o pedido vai como último argumento ou onde estiver {prompt}).
# Sem ele, o Orbi não mexe em código: devolve o diagnóstico a quem pediu.
# ORBI_CODE_AGENT=claude -p --permission-mode acceptEdits
# ORBI_CODE_AGENT=codex exec --full-auto {prompt}

# ORBI_MODEL=anthropic/claude-haiku-5-5

# Where your repositories are cloned (commands run inside this folder; ~ works and it is created if missing)
ORBI_WORKSPACE=~/projetos
# CLIs the agent may run (no shell; binary + args). On Windows, python3 runs as python or py.
# ORBI_ALLOWED_BINARIES=git,gh,aws,python3,python,py,node,npm,mvn,cp,mkdir,cat
# The developer's shell, for run_shell (pipes, &&, scripts) and, on Windows, for .cmd programs
# (npm, mvn). Found by itself: Git Bash on Windows, bash elsewhere. A path picks one; off disables.
# ORBI_SHELL=C:\Program Files\Git\bin\bash.exe

# Credentials handed to CLIs explicitly (never the whole environment)
GH_TOKEN=
AWS_PROFILE=
AWS_REGION=sa-east-1

# Chrome DevTools MCP bridge
# Attach to your own Chrome (keeps your SSO sessions): start Chrome with
#   --remote-debugging-port=9222 --user-data-dir=~/.orbi-chrome
# CHROME_BROWSER_URL=http://127.0.0.1:9222
# CHROME_MCP_PORT=8931
# CHROME_MCP_TOKEN=   # generated per run when empty
# CHROME_HEADLESS=false

# Local data (brain.db, flue.db, inbox, autonomy)
# ORBI_DATA_DIR=./data
# Require a bearer token on the local HTTP API
# Onde o runtime escuta. Padrão: só nesta máquina. Mude apenas num contêiner.
# ORBI_HOST=127.0.0.1
# ORBI_API_TOKEN=

# Logs: json (uma linha JSON por evento) ou pretty; nível debug | info | warn | error.
# Padrão: pretty no terminal, json no app (logs/runtime.log).
# ORBI_LOG_FORMAT=
# ORBI_LOG_LEVEL=info

# ── Ensinar pelo navegador ───────────────────────────────────────────────
# Chrome que o Orbi abre (perfil próprio em data/chrome-profile; logins persistem)
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_DEBUG_PORT=9333
# CHROME_BROWSER_URL=http://127.0.0.1:9222   # usar um Chrome seu, aberto com --remote-debugging-port

# Cofre de credenciais: auto (Keychain do macOS; arquivo criptografado se não houver) | keychain | file
# ORBI_VAULT=auto
# ORBI_VAULT_KEY=...                         # só para o modo file: chave em vez de data/vault.key

# Transcrição da narração: local (Whisper nesta máquina) | http | off
# ORBI_STT=local
# Rede da empresa bloqueia huggingface.co? Aponte para um espelho (ex.: Artifactory)
# ou copie o modelo para ORBI_MODELS_DIR e ligue o modo offline:
# ORBI_STT_MODEL_HOST=https://artifactory.empresa.com/api/huggingfaceml/huggingface/
# ORBI_STT_OFFLINE=true
# ORBI_STT_LOCAL_MODEL=onnx-community/whisper-small   # ~250 MB, baixado na 1ª vez para data/models
# ORBI_STT_URL=https://api.openai.com/v1/audio/transcriptions   # qualquer endpoint compatível
# ORBI_STT_API_KEY=...
# ORBI_STT_MODEL=whisper-1
# ORBI_STT_LANGUAGE=pt
