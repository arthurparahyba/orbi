{
  "name": "@orbi/runtime",
  "version": "0.1.0",
  "description": "Orbi — copiloto de esteira (runtime em Flue/Pi com Claude Haiku 5.5)",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node dist/server.mjs",
    "check:types": "tsc --noEmit",
    "test": "node --import tsx --import ./scripts/register-raw.mjs --test test/*.test.ts",
    "bridge:chrome": "tsx --import ./scripts/register-raw.mjs src/browser/mcp/bridge-cli.ts",
    "e2e:chrome": "tsx --import ./scripts/register-raw.mjs scripts/e2e-chrome-mcp.ts",
    "demo": "tsx --import ./scripts/register-raw.mjs scripts/demo-server.ts",
    "e2e:demo": "tsx --import ./scripts/register-raw.mjs scripts/e2e-demonstration.ts",
    "plugin:test": "tsx --import ./scripts/register-raw.mjs scripts/plugin-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@earendil-works/pi-ai": "1.1.0",
    "@flue/runtime": "^2.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^2.1.2",
    "chrome-devtools-mcp": "^1.12.0",
    "croner": "^11.0.0",
    "hono": "^4.13.16",
    "js-yaml": "^5.5.0",
    "puppeteer-core": "^24.43.1",
    "ulidx": "^2.4.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@flue/vite": "^2.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "@flue/cli": "^2.3.0"
  },
  "private": true,
  "type": "module"
}
